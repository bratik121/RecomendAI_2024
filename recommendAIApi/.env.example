# ============================================================
# RecomendAI API — variables de entorno (backend Django)
# Copiá este archivo a `.env` y completá con valores reales.
# NUNCA versiones el archivo `.env` (está en .gitignore).
# ============================================================

# ------------------------- Django core -------------------------
# Clave secreta de Django. Generá una nueva, larga y aleatoria:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-please-use-a-real-secret

# True en desarrollo, False en producción.
DEBUG=True

# -------------------------- Database ---------------------------
# URL de conexión (PostgreSQL recomendado). Formato:
#   postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ---------------------- Hosts / CORS / CSRF --------------------
# Hosts permitidos, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Orígenes permitidos para CORS, separados por comas.
# En desarrollo, el frontend de Vite corre en http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Orígenes de confianza para CSRF, separados por comas.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------- Frontend ----------------------------
# URL pública del frontend (usada para redirecciones y CORS).
FRONTEND_URL=http://localhost:5173

# ------------------------- Cloudinary --------------------------
# Credenciales de Cloudinary para el almacenamiento de imágenes.
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu-api-secret

# Carpeta raíz (opcional) para separar entornos (ej: dev/staging/prod).
CLOUDINARY_FOLDER=recomendai

# --------------------------- Email -----------------------------
# Configuración de envío de emails (solo si se usa recuperación/notificaciones).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=tu-password-de-email
DEFAULT_FROM_EMAIL=RecomendAI <no-reply@example.com>
